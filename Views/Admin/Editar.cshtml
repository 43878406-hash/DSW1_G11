@model JoyeriaMorgan.Models.ProductoViewModel
@{
    ViewData["Title"] = "Editar Joya";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="card border-0 bg-light p-4 p-md-5 rounded-0">
            <h2 class="section-title-kaira mb-4" style="font-size: 1.8rem;">Editar Joya: @Model.Nombre</h2>

            <form asp-action="Editar" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoriaId" class="form-label small text-uppercase fw-bold"></label>
                        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias"
                                class="form-select rounded-0 p-2"></select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label small text-uppercase fw-bold"></label>
                        <input asp-for="Nombre" class="form-control rounded-0 p-2" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label small text-uppercase fw-bold"></label>
                    <textarea asp-for="Descripcion" class="form-control rounded-0 p-2" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Precio" class="form-label small text-uppercase fw-bold">Precio (S/)</label>
                        <input asp-for="Precio" type="number" step="0.01" class="form-control rounded-0 p-2" />
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label small text-uppercase fw-bold"></label>
                        <input asp-for="Stock" type="number" class="form-control rounded-0 p-2" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ImagenUrl" class="form-label small text-uppercase fw-bold">URL de Imagen</label>
                    <input asp-for="ImagenUrl" class="form-control rounded-0 p-2" />
                    <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn-link-kaira">&larr; Cancelar</a>
                    <button type="submit" class="btn btn-dark px-5 py-2 text-uppercase rounded-0">Actualizar
                        Joya</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }