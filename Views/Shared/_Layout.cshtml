@{
    // Unidades en la bolsa de compra, para el globito del icono del carrito.
    int totalItemsCarrito = Context.Session.ContarItemsCarrito();
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Morgan</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Marcellus&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/lux/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 bg-white">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center me-4" asp-area="" asp-controller="Home"
                   asp-action="Index">
                    <svg width="180" height="42" viewBox="0 0 190 42" xmlns="http://www.w3.org/2000/svg" fill="#111">
                        <text x="0" y="32" font-family="'Marcellus', serif" font-size="32" font-weight="400"
                              letter-spacing="5" fill="#111">
                            MORGAN
                        </text>
                    </svg>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 text-uppercase fs-6">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Producto" asp-action="Index">Catálogo</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item me-4">
                            <a class="nav-link text-dark text-uppercase tracking-widest d-flex align-items-center position-relative"
                               asp-controller="Carrito" asp-action="Index" title="Bolsa de compra"
                               style="font-size: 0.85rem; font-weight: 500;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.5" class="me-1">
                                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                    <line x1="3" y1="6" x2="21" y2="6"></line>
                                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                                </svg>
                                @if (totalItemsCarrito > 0)
                                {
                                    <span class="badge rounded-pill bg-dark position-absolute top-0 start-100 translate-middle"
                                          style="font-size: 0.62rem;">
                                        @totalItemsCarrito
                                        <span class="visually-hidden">joyas en la bolsa</span>
                                    </span>
                                }
                            </a>
                        </li>

                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark text-uppercase tracking-widest" href="#"
                                   id="menuUsuario" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                   style="font-size: 0.85rem; font-weight: 500;">
                                    Hola, <strong>@User.Identity.Name</strong>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end rounded-0 border shadow-sm mt-2"
                                    aria-labelledby="menuUsuario">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 small text-uppercase" asp-controller="Admin"
                                               asp-action="Index">
                                                Inventario de Joyas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 small text-uppercase" asp-controller="Categoria"
                                               asp-action="Index">
                                                Categorías
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider my-1">
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2 small text-uppercase" asp-controller="Pedido"
                                           asp-action="MisPedidos">
                                            Mis Pedidos
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider my-1">
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 small text-uppercase text-danger"
                                           asp-controller="Login" asp-action="Logout">
                                            Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-dark btn-sm text-uppercase rounded-0" asp-controller="Login"
                                   asp-action="Login">Ingresar</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-dark btn-sm text-uppercase rounded-0" asp-controller="Login"
                                   asp-action="Registrar">Crear Cuenta</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="py-4">
            <partial name="_Alertas" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-5 mt-5 bg-light">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <div class="col-md-4">
                    <h5 class="text-uppercase mb-3">Morgan</h5>
                    <p class="small text-muted mb-0">
                        Piezas exclusivas en Oro de 18k y Plata 925 elaboradas artesanalmente con los más altos
                        estándares de calidad y diseño clásico.
                    </p>
                </div>

                <div class="col-md-2 col-sm-6">
                    <h6 class="text-uppercase mb-3 small fw-bold">Navegación</h6>
                    <ul class="list-unstyled small text-uppercase">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Index"
                               class="text-decoration-none text-muted">Inicio</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Producto" asp-action="Index"
                               class="text-decoration-none text-muted">Catálogo</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Login" asp-action="Login"
                               class="text-decoration-none text-muted">Mi Cuenta</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-2 col-sm-6">
                    <h6 class="text-uppercase mb-3 small fw-bold">Colecciones</h6>
                    <ul class="list-unstyled small text-uppercase">
                        <li class="mb-2">
                            <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Anillos"
                               class="text-decoration-none text-muted">Anillos</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Collares"
                               class="text-decoration-none text-muted">Collares</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Aretes"
                               class="text-decoration-none text-muted">Aretes</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h6 class="text-uppercase mb-3 small fw-bold">Atención al Cliente</h6>
                    <p class="small text-muted mb-1">Lima, Perú</p>
                    <p class="small text-muted mb-0">contacto@joyeriamorgan.pe</p>
                </div>
            </div>

            <hr class="my-4 text-muted" />

            <div class="text-center small text-muted">
                &copy; 2026 - Morgan. Todos los derechos reservados.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
