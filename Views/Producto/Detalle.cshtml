@model JoyeriaMorgan.Models.ProductoViewModel
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small text-uppercase tracking-widest">
            &larr; Volver al Catálogo
        </a>
    </div>

    <div class="row g-5 align-items-center">
        <div class="col-md-6">
            <div class="image-zoom-holder shadow-sm">
                @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
                {
                    <img src="@Model.ImagenUrl" alt="@Model.Nombre" style="height: 520px;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light text-muted"
                         style="height: 520px;">
                        <span>Sin Imagen</span>
                    </div>
                }
            </div>
        </div>


        <div class="col-md-6">
            <span class="text-uppercase text-muted small tracking-widest">@Model.NombreCategoria</span>
            <h1 class="section-title-kaira mt-2 mb-3" style="font-size: 2.4rem;">@Model.Nombre</h1>

            <div class="fs-4 text-dark mb-4">
                S/ @Model.Precio.ToString("N2")
            </div>

            <hr class="text-muted my-4" />

            <p class="text-muted lh-lg mb-4">
                @(string.IsNullOrEmpty(Model.Descripcion) ? "Joya elaborada artesanalmente con metales nobles y terminaciones de alta precisión." : Model.Descripcion)
            </p>

            <div class="small text-uppercase mb-4 @(Model.Stock > 0 ? "text-success" : "text-danger")">
                @(Model.Stock > 0 ? $"• Disponible en stock ({Model.Stock} unidades)" : "Agotado temporalmente")
            </div>

            

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-dark px-5 text-uppercase fs-6 rounded-0">
                    Seguir Explorando
                </a>
            </div>

            @if (Model.Stock > 0)
{
    <form asp-controller="Carrito" asp-action="Agregar" method="post" class="mt-4">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="d-flex gap-2 align-items-center">
            <input type="number" name="cantidad" value="1" min="1" max="@Model.Stock" 
                   class="form-control text-center rounded-0" style="width: 80px;" />
            <button type="submit" class="btn btn-dark px-4 py-2 text-uppercase rounded-0 flex-grow-1">
                Añadir a la Bolsa
            </button>
        </div>
    </form>
}
        </div>
    </div>
</div>