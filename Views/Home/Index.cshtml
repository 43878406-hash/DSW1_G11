@{
    ViewData["Title"] = "Inicio";
}


<section class="py-5 my-4">
    <div class="container">

        <div class="text-center mb-5 pb-3">
            <h1 class="section-title-kaira">Nuevas Colecciones</h1>
            <p class="section-subtitle-kaira">
                Descubre nuestra exclusiva selección de alta joyería. Piezas trabajadas en metales nobles
                con diseños atemporales que resaltan la elegancia y tradición de Joyería Morgan.
            </p>
        </div>

      
        <div class="row g-4">

            <div class="col-md-4">
                <div class="card-item text-start">
                    <div class="image-zoom-holder">
                        <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Anillos">
                            <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?q=80&w=600&auto=format&fit=crop"
                                 alt="Anillos de Oro y Plata" />
                        </a>
                    </div>
                    <h5 class="kaira-card-title">Anillos de Oro 18k</h5>
                    <p class="text-muted small mb-3 lh-base">
                        Solitarios de compromiso, argollas tradicionales y piezas finas en oro amarillo, blanco y rosa.
                    </p>
                    <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Anillos" class="btn-link-kaira">
                        Ver Colección
                    </a>
                </div>
            </div>

           
            <div class="col-md-4">
                <div class="card-item text-start">
                    <div class="image-zoom-holder">
                        <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Collares">
                            <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=600&auto=format&fit=crop"
                                 alt="Collares & Dijes" />
                        </a>
                    </div>
                    <h5 class="kaira-card-title">Collares & Dijes</h5>
                    <p class="text-muted small mb-3 lh-base">
                        Cadenas finas y colgantes exclusivos con incrustaciones de perlas naturales de río y circonios.
                    </p>
                    <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Collares" class="btn-link-kaira">
                        Ver Colección
                    </a>
                </div>
            </div>

           
            <div class="col-md-4">
                <div class="card-item text-start">
                    <div class="image-zoom-holder">
                        <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Aretes">
                            <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?q=80&w=600&auto=format&fit=crop"
                                 alt="Aretes en Plata 925" />
                        </a>
                    </div>
                    <h5 class="kaira-card-title">Aretes en Plata 925</h5>
                    <p class="text-muted small mb-3 lh-base">
                        Pendientes, broqueles y diseños colgantes elaborados en plata bañada en rodio de alta pureza.
                    </p>
                    <a asp-controller="Producto" asp-action="Index" asp-route-buscar="Aretes" class="btn-link-kaira">
                        Ver Colección
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>